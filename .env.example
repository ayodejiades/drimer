# Database — Neon pooled connection string (use pooled for Vercel serverless)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"

# Testnet wallet — brand-new keypair, testnet only, never reuse a mainnet key
# privateKey is passed directly to SomniaMarkets constructor (no separate session key delegation needed for MVP)
TESTNET_WALLET_PRIVATE_KEY="0x..."

# Somnia Shannon testnet — get exact values from docs.dreamdex.io/developers/event-contracts and its Contracts & Addresses page
DREAMDEX_NETWORK="shannon-testnet"
DREAMDEX_INDEXER_URL="https://indexer.shannon.somnia.network"
DREAMDEX_WS_RPC_URL="wss://shannon-rpc.somnia.network/ws"
DREAMDEX_CHAIN="shannon-testnet"
DREAMDEX_VENUE_ID="0x..."
# DREAMDEX contract addresses object as JSON string (from docs) — if needed as separate env vars:
# DREAMDEX_ADDRESSES='{"orderbook":"0x...","settlement":"0x..."}'
# Legacy aliases kept for backwards compat (not used by new SDK path):
DREAMDEX_RPC_URL="https://shannon-rpc.somnia.network"
DREAMDEX_API_BASE="https://api.dreamdex.io"
# SESSION_KEY is no longer required for MVP (privateKey is used directly); keep for backwards compat if set:
SESSION_KEY="0x..."

# MCP — shared secret for place_trade auth (read tools stay open)
MCP_SHARED_SECRET="change-me-to-a-random-string"

# ASSET / DURATION defaults for orchestrator (optional)
ASSET="ETH"
DURATION="FIFTEEN_MIN"

# MCP server port
MCP_PORT="3001"
